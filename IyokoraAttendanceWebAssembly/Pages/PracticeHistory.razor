@page "/history"
@inject PracticeService PracticeService
@inject LocalProfileStore Profile
@inject NavigationManager Nav

<div class="page-pad">

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <p class="error-text">@_errorMessage</p>
    }

    @if (_isBusy)
    {
        <p class="hint-text">読み込み中...</p>
    }
    else if (_practices.Count == 0)
    {
        <p class="empty-text">過去の練習データはありません。</p>
    }
    else
    {
        @foreach (var practice in _practices)
        {
            <div class="list-card clickable" @onclick="() => OpenDetail(practice)">
                <div>
                    <p class="list-card-title">@practice.Date.ToString("yyyy年M月d日(ddd)")</p>
                    @if (!string.IsNullOrEmpty(practice.Title))
                    {
                        <p class="list-card-sub">@practice.Title</p>
                    }
                    @if (!string.IsNullOrEmpty(practice.Place))
                    {
                        <p class="list-card-sub">📍 @practice.Place</p>
                    }
                    @if (!string.IsNullOrEmpty(practice.PiecesSummary))
                    {
                        <p class="list-card-sub">🎵 @practice.PiecesSummary</p>
                    }
                </div>
                @if (Profile.Role == Role.Admin)
                {
                    <button class="iyk-btn-text-danger" @onclick="() => DeletePracticeAsync(practice)" @onclick:stopPropagation="true">削除</button>
                }
            </div>
        }
    }
</div>

@code {
    private List<Practice> _practices = [];
    private bool _isBusy;
    private string? _errorMessage;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isBusy = true;
        _errorMessage = null;
        try
        {
            _practices = await PracticeService.GetPastAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"読み込みに失敗しました。({ex.Message})";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeletePracticeAsync(Practice practice)
    {
        if (Profile.Role != Role.Admin)
            return;

        try
        {
            await PracticeService.DeleteAsync(practice.Id);
            _practices.Remove(practice);
        }
        catch (Exception ex)
        {
            _errorMessage = $"削除に失敗しました。({ex.Message})";
        }
    }

    private void OpenDetail(Practice practice) => Nav.NavigateTo($"practice/{practice.Id}");
}
