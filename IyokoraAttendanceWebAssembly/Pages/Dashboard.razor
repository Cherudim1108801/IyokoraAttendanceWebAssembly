@page "/"
@inject MemberService MemberService
@inject PracticeService PracticeService
@inject AttendanceService AttendanceService
@inject LocalProfileStore Profile
@inject NavigationManager Nav

<div class="page-pad">

    <h2 style="font-size:18px;font-weight:bold;">こんにちは、@Profile.Name さん</h2>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <p class="error-text">@_errorMessage</p>
    }

    @if (_nextPractice is not null)
    {
        <div class="highlight-card" style="cursor:pointer;" @onclick="OpenTimelineModal">
            <div class="highlight-card-label">次回の練習</div>
            <div class="highlight-card-date">@_nextPractice.Date.ToString("yyyy年M月d日(ddd)")</div>
            @if (!string.IsNullOrEmpty(_nextPractice.TimeRangeSummary))
            {
                <div>🕒 @_nextPractice.TimeRangeSummary</div>
            }
            @if (!string.IsNullOrEmpty(_nextPractice.Title))
            {
                <div>@_nextPractice.Title</div>
            }
            @if (!string.IsNullOrEmpty(_nextPractice.Place))
            {
                <div style="color:#6E6E6E;">📍 @_nextPractice.Place</div>
            }
            <div class="hint-text" style="margin:6px 0 0;">タップしてタイムスケジュールを見る</div>
        </div>

        <div class="section">
            <h3 class="section-title">あなたの出欠</h3>
            <AttendanceButtons Status="_myStatus" StatusChanged="SetMyStatusAsync" />
        </div>

        <PartSummaryPanel Summaries="_partSummaries" />

        <p style="font-weight:bold;margin:4px 0 0;">合計 参加予定: @_totalAttending 人</p>
        <p class="hint-text">回答済み: @_totalResponded 人 (登録メンバー全 @_totalMembers 人)</p>
    }
    else if (!_isBusy)
    {
        <div class="highlight-card">
            <p style="font-weight:bold;margin:0 0 10px;">次回の練習予定が登録されていません</p>
            @if (Profile.Role.CanRegisterSchedule())
            {
                <button class="iyk-btn iyk-btn-primary" @onclick='() => Nav.NavigateTo("schedule")'>予定を登録する</button>
            }
        </div>
    }

    @if (_isBusy)
    {
        <p class="hint-text">読み込み中...</p>
    }
</div>

@if (_isTimelineModalVisible && _nextPractice is not null)
{
    <div class="iyk-modal-backdrop" @onclick="CloseTimelineModal">
        <div class="iyk-modal-panel" @onclick:stopPropagation="true">
            <div class="iyk-modal-title">@_nextPractice.Date.ToString("yyyy年M月d日(ddd)")</div>
            @if (!string.IsNullOrEmpty(_nextPractice.TimeRangeSummary))
            {
                <div class="iyk-modal-sub">🕒 @_nextPractice.TimeRangeSummary</div>
            }
            <hr class="divider" />
            <h3 class="section-title">タイムスケジュール</h3>
            @if (_nextPractice.TimelineItems.Count == 0)
            {
                <p class="hint-text">タイムスケジュールは登録されていません。</p>
            }
            else
            {
                @foreach (var item in _nextPractice.TimelineItems.OrderBy(i => i.StartTime))
                {
                    <div class="list-card">
                        <div>
                            <p class="list-card-title">@item.StartTime 〜 @item.EndTime</p>
                            @if (!string.IsNullOrEmpty(item.Content))
                            {
                                <p class="list-card-sub">@item.Content</p>
                            }
                        </div>
                    </div>
                }
            }
            <button class="iyk-btn iyk-btn-block" style="margin-top:8px;" @onclick="CloseTimelineModal">閉じる</button>
        </div>
    </div>
}

@code {
    private List<PartSummary> _partSummaries = [];
    private Practice? _nextPractice;
    private List<Member> _members = [];
    private List<Attendance> _attendances = [];
    private AttendanceStatus _myStatus = AttendanceStatus.Undecided;
    private bool _isTimelineModalVisible;
    private int _totalAttending;
    private int _totalMembers;
    private int _totalResponded;
    private bool _isBusy;
    private string? _errorMessage;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isBusy = true;
        _errorMessage = null;
        try
        {
            var practice = await PracticeService.GetNextUpcomingAsync();
            _nextPractice = practice;
            _members = await MemberService.GetAllAsync();
            _attendances = practice is null
                ? []
                : await AttendanceService.GetForPracticeAsync(practice.Id);

            RecomputeSummaries();
        }
        catch (Exception ex)
        {
            _errorMessage = $"読み込みに失敗しました。ネットワーク接続と Firebase 設定を確認してください。({ex.Message})";
        }
        finally
        {
            _isBusy = false;
        }
    }

    /// <summary>
    /// 既に読み込み済みの <see cref="_nextPractice"/>・<see cref="_members"/>・<see cref="_attendances"/> から
    /// 画面表示用の集計値を再計算する。出欠の変更後にFirestoreへ再度問い合わせずに済むよう、
    /// ローカルに保持したデータのみを使って呼び出せるようにしている。
    /// </summary>
    private void RecomputeSummaries()
    {
        _totalMembers = _members.Count;
        _partSummaries = [];

        if (_nextPractice is null)
        {
            _totalAttending = 0;
            _totalResponded = 0;
            _myStatus = AttendanceStatus.Undecided;
            return;
        }

        var mine = _attendances.FirstOrDefault(a => a.MemberId == Profile.MemberId);
        _myStatus = mine?.Status ?? AttendanceStatus.Undecided;

        var attendingByPart = _attendances
            .Where(a => a.Status == AttendanceStatus.Attending)
            .GroupBy(a => a.Part)
            .ToDictionary(g => g.Key, g => g.Count());

        var attendingNamesByPart = _attendances
            .Where(a => a.Status == AttendanceStatus.Attending)
            .GroupBy(a => a.Part)
            .ToDictionary(
                g => g.Key,
                g => (IReadOnlyList<string>)g.Select(a => a.MemberName).OrderBy(n => n, StringComparer.CurrentCultureIgnoreCase).ToList());

        var membersByPart = _members.GroupBy(m => m.Part).ToDictionary(g => g.Key, g => g.Count());

        var summaries = new List<PartSummary>();
        foreach (var part in PartTypeExtensions.All)
        {
            summaries.Add(new PartSummary
            {
                Part = part,
                Label = part.ToDisplayName(),
                ColorHex = part.ToColorHex(),
                CardBackgroundColorHex = part.ToCardBackgroundColorHex(),
                AttendingCount = attendingByPart.GetValueOrDefault(part),
                MemberCount = membersByPart.GetValueOrDefault(part),
                AttendeeNames = attendingNamesByPart.GetValueOrDefault(part) ?? []
            });
        }
        _partSummaries = summaries;

        _totalAttending = attendingByPart.Values.Sum();
        _totalResponded = _attendances.Count(a => a.Status != AttendanceStatus.Undecided);
    }

    private async Task SetMyStatusAsync(AttendanceStatus status)
    {
        if (_nextPractice is null)
            return;

        try
        {
            await AttendanceService.SetStatusAsync(_nextPractice.Id, Profile.MemberId, Profile.Name, Profile.Part, status);

            // メンバー一覧・練習予定は変化しないためそのまま使い回し、出欠だけをサーバー側で絞り込み再取得する。
            // こうすることで、自分の変更と同時に他メンバーが行った出欠変更も画面に反映される。
            _attendances = await AttendanceService.GetForPracticeAsync(_nextPractice.Id);
            RecomputeSummaries();
        }
        catch (Exception ex)
        {
            _errorMessage = $"更新に失敗しました。({ex.Message})";
        }
    }

    private void OpenTimelineModal() => _isTimelineModalVisible = true;

    private void CloseTimelineModal() => _isTimelineModalVisible = false;
}
