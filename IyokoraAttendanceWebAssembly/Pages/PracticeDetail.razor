@page "/practice/{PracticeId}"
@inject PracticeService PracticeService
@inject MemberService MemberService
@inject AttendanceService AttendanceService
@inject PieceService PieceService
@inject LocalProfileStore Profile
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="page-pad">

    @if (_practice is not null)
    {
        <div class="section">
            <h2 style="font-size:24px;font-weight:bold;margin:0;">@_practice.Date.ToString("yyyy年M月d日(ddd)")</h2>
            @if (!string.IsNullOrEmpty(_practice.Title))
            {
                <p style="margin:4px 0;">@_practice.Title</p>
            }
            @if (!string.IsNullOrEmpty(_practice.TimeRangeSummary))
            {
                <p class="hint-text">🕒 @_practice.TimeRangeSummary</p>
            }
            @if (!string.IsNullOrEmpty(_practice.Place))
            {
                <p class="hint-text">📍 @_practice.Place</p>
            }
            @if (!string.IsNullOrEmpty(_practice.PiecesSummary))
            {
                <p class="hint-text">🎵 @_practice.PiecesSummary</p>
            }
            <p>参加予定: @_totalAttending / @_totalMembers 人</p>
        </div>
    }

    @if (_practice is not null)
    {
        <div class="section">
            <div style="display:flex;align-items:center;justify-content:space-between;">
                <h3 class="section-title" style="margin:0;">タイムスケジュール</h3>
                @if (Profile.Role == Role.Admin && !_isScheduleEditPanelVisible)
                {
                    <button class="iyk-btn-text" @onclick="OpenScheduleEditPanel">編集</button>
                }
            </div>

            @if (_isScheduleEditPanelVisible)
            {
                <div class="highlight-card" style="margin-top:6px;">
                    <div class="field">
                        <label>開始時刻（任意）</label>
                        <input type="time" step="600" @bind="_editStartTime" @bind:event="oninput" />
                    </div>
                    <div class="field">
                        <label>終了時刻（任意）</label>
                        <input type="time" step="600" @bind="_editEndTime" @bind:event="oninput" />
                    </div>

                    @foreach (var item in _editTimelineItems)
                    {
                        <div class="highlight-card" style="margin-top:6px;">
                            <div class="field">
                                <label>開始</label>
                                <input type="time" step="600" @bind="item.StartTime" @bind:event="oninput" />
                            </div>
                            <div class="field">
                                <label>終了</label>
                                <input type="time" step="600" @bind="item.EndTime" @bind:event="oninput" />
                            </div>
                            <div class="field">
                                <label>内容</label>
                                <input type="text" placeholder="例：基礎合奏" @bind="item.Content" @bind:event="oninput" />
                            </div>
                            <button class="iyk-btn-text-danger" @onclick="() => RemoveEditTimelineItem(item)">この項目を削除</button>
                        </div>
                    }
                    <button class="iyk-btn iyk-btn-block" style="margin-top:6px;" @onclick="AddEditTimelineItem">＋ タイムスケジュールの項目を追加</button>

                    <div style="display:flex;gap:8px;margin-top:8px;">
                        <button class="iyk-btn iyk-btn-primary" style="flex:1;" @onclick="SaveScheduleAsync">保存</button>
                        <button class="iyk-btn" style="flex:1;" @onclick="CloseScheduleEditPanel">キャンセル</button>
                    </div>
                </div>
            }
            else if (_practice.TimelineItems.Count == 0)
            {
                <p class="hint-text">タイムスケジュールは登録されていません。</p>
            }
            else
            {
                @foreach (var item in _practice.TimelineItems.OrderBy(i => i.StartTime))
                {
                    <div class="list-card">
                        <div>
                            <p class="list-card-title">@item.StartTime 〜 @item.EndTime</p>
                            @if (!string.IsNullOrEmpty(item.Content))
                            {
                                <p class="list-card-sub">@item.Content</p>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }

    @if (_practice is not null)
    {
        <div class="section">
            <div style="display:flex;align-items:center;justify-content:space-between;">
                <h3 class="section-title" style="margin:0;">演奏予定曲</h3>
                @if (Profile.Role == Role.Admin && !_isPiecesEditPanelVisible)
                {
                    <button class="iyk-btn-text" @onclick="OpenPiecesEditPanel">編集</button>
                }
            </div>

            @if (_isPiecesEditPanelVisible)
            {
                <div class="highlight-card" style="margin-top:6px;">
                    @if (_editPieceInputs.Count == 0)
                    {
                        <p class="hint-text">登録されている曲はありません。「曲」タブから登録できます。</p>
                    }
                    else
                    {
                        @foreach (var input in _editPieceInputs)
                        {
                            <div class="checkbox-row">
                                <input type="checkbox" id="@("edit_piece_" + input.PieceId)" @bind="input.IsSelected" />
                                <label for="@("edit_piece_" + input.PieceId)">@input.Title</label>
                            </div>
                        }
                    }
                    <div style="display:flex;gap:8px;margin-top:8px;">
                        <button class="iyk-btn iyk-btn-primary" style="flex:1;" @onclick="SavePiecesAsync">保存</button>
                        <button class="iyk-btn" style="flex:1;" @onclick="ClosePiecesEditPanel">キャンセル</button>
                    </div>
                </div>
            }
            else if (_practice.Pieces.Count == 0)
            {
                <p class="hint-text">演奏予定曲は登録されていません。</p>
            }
            else
            {
                <p>@_practice.PiecesSummary</p>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <p class="error-text">@_errorMessage</p>
    }

    @if (_practice is not null)
    {
        <div class="section">
            <h3 class="section-title">あなたの出欠</h3>
            @if (!_isAttendanceEditable)
            {
                <p class="hint-text">過去の練習のため、出欠は変更できません。</p>
            }
            <AttendanceButtons Status="_myStatus" Disabled="!_isAttendanceEditable" StatusChanged="SetMyStatusAsync" />
        </div>

        <PartSummaryPanel Summaries="_partSummaries" Title="パート別 参加人数" />

        @if (_songParticipations.Count > 0)
        {
            <div class="section">
                <h3 class="section-title">曲ごとの参加人数</h3>
                <p class="hint-text">○の色はパート、「上」「下」は曲内の分割担当を表します</p>

                @foreach (var song in _songParticipations)
                {
                    <div style="margin-bottom:16px;">
                        <p style="font-weight:bold;font-size:14px;margin:0 0 6px;">@song.Title</p>
                        <div class="dot-wrap">
                            @foreach (var dot in song.Dots)
                            {
                                <div class="dot" style="background-color:@dot.ColorHex;margin:@dot.Margin;">@dot.SubLabel</div>
                            }
                        </div>
                        <div style="display:flex;align-items:center;gap:6px;margin-top:6px;flex-wrap:wrap;">
                            @if (song.IsFeatured)
                            {
                                <span class="badge-star">★</span>
                            }
                            @if (song.HasRecordingUrl)
                            {
                                <a href="@song.RecordingUrl" target="_blank" rel="noopener noreferrer" style="font-size:13px;color:#512BD4;">🎵 録音を聴く</a>
                            }
                            else
                            {
                                <span class="hint-text" style="margin:0;">録音リンク未登録</span>
                            }

                            @if (Profile.Role == Role.Admin)
                            {
                                <span style="flex:1;"></span>
                                @if (song.CanToggleFeaturedOn)
                                {
                                    <button class="iyk-btn-text" @onclick="() => ToggleRecordingFeaturedAsync(song)">★ 注目に設定</button>
                                }
                                @if (song.CanToggleFeaturedOff)
                                {
                                    <button class="iyk-btn-text-star" @onclick="() => ToggleRecordingFeaturedAsync(song)">★ 注目解除</button>
                                }
                                <button class="iyk-btn-text" @onclick="() => EditRecordingAsync(song)">編集</button>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @if (Profile.Role == Role.Admin)
        {
            <div class="section">
                <h3 class="section-title">鍵の受け取り状況</h3>
                @if (!_practice.RequiresKeyPickup)
                {
                    <p class="hint-text">この練習では鍵の受け取りは不要です。</p>
                }
                else
                {
                    <div style="display:flex;align-items:center;justify-content:space-between;">
                        @if (_practice.KeyPickedUp)
                        {
                            <span style="color:#3EC1A4;font-weight:bold;">
                                受け取り済み
                                @if (!string.IsNullOrEmpty(_practice.KeyPickedUpByName))
                                {
                                    @($"（{_practice.KeyPickedUpByName}）")
                                }
                            </span>
                            <button class="iyk-btn-text" @onclick="ToggleKeyPickedUpAsync">未受け取りに戻す</button>
                        }
                        else
                        {
                            <span style="color:#D600AA;font-weight:bold;">未受け取り</span>
                            <button class="iyk-btn-text-primary" @onclick="ToggleKeyPickedUpAsync">受け取り済みにする</button>
                        }
                    </div>
                }
            </div>
        }

        @if (Profile.Role == Role.Admin)
        {
            <div class="section">
                <button class="iyk-btn iyk-btn-outline-danger iyk-btn-block" @onclick="DeletePracticeAsync">この練習予定を削除</button>
            </div>
        }
    }
    else if (_isBusy)
    {
        <p class="hint-text">読み込み中...</p>
    }
</div>

@code {
    [Parameter]
    public string PracticeId { get; set; } = string.Empty;

    private Practice? _practice;
    private AttendanceStatus _myStatus = AttendanceStatus.Undecided;
    private int _totalAttending;
    private int _totalMembers;
    private bool _isAttendanceEditable = true;
    private List<PartSummary> _partSummaries = [];
    private List<SongParticipation> _songParticipations = [];
    private bool _isBusy;
    private string? _errorMessage;

    private bool _isScheduleEditPanelVisible;
    private TimeOnly? _editStartTime;
    private TimeOnly? _editEndTime;
    private List<TimelineItemInput> _editTimelineItems = [];

    private List<Piece> _pieces = [];
    private bool _isPiecesEditPanelVisible;
    private List<PieceSelectionInput> _editPieceInputs = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (string.IsNullOrEmpty(PracticeId))
            return;

        _isBusy = true;
        _errorMessage = null;
        try
        {
            _practice = await PracticeService.GetByIdAsync(PracticeId);
            _isAttendanceEditable = _practice is null || _practice.Date.Date >= DateTime.Today;
            var members = await MemberService.GetAllAsync();
            var pieces = await PieceService.GetAllAsync(includeArchived: true);
            _pieces = pieces;
            var attendances = await AttendanceService.GetForPracticeAsync(PracticeId);
            var statusByMemberId = attendances.ToDictionary(a => a.MemberId, a => a.Status);

            _myStatus = statusByMemberId.GetValueOrDefault(Profile.MemberId, AttendanceStatus.Undecided);
            _totalMembers = members.Count;
            _totalAttending = attendances.Count(a => a.Status == AttendanceStatus.Attending);

            var attendingByPart = attendances
                .Where(a => a.Status == AttendanceStatus.Attending)
                .GroupBy(a => a.Part)
                .ToDictionary(g => g.Key, g => g.Count());

            var attendingNamesByPart = attendances
                .Where(a => a.Status == AttendanceStatus.Attending)
                .GroupBy(a => a.Part)
                .ToDictionary(
                    g => g.Key,
                    g => (IReadOnlyList<string>)g.Select(a => a.MemberName).OrderBy(n => n, StringComparer.CurrentCultureIgnoreCase).ToList());

            var membersByPart = members.GroupBy(m => m.Part).ToDictionary(g => g.Key, g => g.Count());

            var summaries = new List<PartSummary>();
            foreach (var part in PartTypeExtensions.All)
            {
                summaries.Add(new PartSummary
                {
                    Part = part,
                    Label = part.ToDisplayName(),
                    ColorHex = part.ToColorHex(),
                    CardBackgroundColorHex = part.ToCardBackgroundColorHex(),
                    AttendingCount = attendingByPart.GetValueOrDefault(part),
                    MemberCount = membersByPart.GetValueOrDefault(part),
                    AttendeeNames = attendingNamesByPart.GetValueOrDefault(part) ?? []
                });
            }
            _partSummaries = summaries;

            var attendingMembers = members
                .Where(m => statusByMemberId.GetValueOrDefault(m.Id) == AttendanceStatus.Attending)
                .OrderBy(m => m.Part)
                .ThenBy(m => m.Name, StringComparer.CurrentCultureIgnoreCase)
                .ToList();

            var piecesById = pieces.ToDictionary(p => p.Id);

            var songs = new List<SongParticipation>();
            foreach (var pieceRef in _practice?.Pieces ?? [])
            {
                piecesById.TryGetValue(pieceRef.PieceId, out var piece);

                var dots = new List<ParticipationDot>();
                PartType? previousPart = null;
                foreach (var member in attendingMembers)
                {
                    var assignment = piece?.PartAssignments.FirstOrDefault(a => a.Part == member.Part);
                    string? subLabel = null;
                    if (assignment is { Division: PartDivision.UpperLower })
                    {
                        var subPart = member.PieceParts.FirstOrDefault(p => p.PieceId == pieceRef.PieceId)?.SubPart;
                        var labels = assignment.SubPartLabels;
                        if (subPart == labels[0])
                            subLabel = "上";
                        else if (subPart == labels[1])
                            subLabel = "下";
                    }

                    dots.Add(new ParticipationDot
                    {
                        ColorHex = member.Part.ToCardBackgroundColorHex(),
                        SubLabel = subLabel,
                        Margin = previousPart is not null && previousPart != member.Part
                            ? "4px 4px 4px 14px"
                            : "4px"
                    });
                    previousPart = member.Part;
                }

                songs.Add(new SongParticipation
                {
                    PieceId = pieceRef.PieceId,
                    Title = pieceRef.Title,
                    Dots = dots,
                    RecordingUrl = pieceRef.RecordingUrl,
                    IsFeatured = pieceRef.IsFeatured
                });
            }
            _songParticipations = songs;
        }
        catch (Exception ex)
        {
            _errorMessage = $"読み込みに失敗しました。({ex.Message})";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SetMyStatusAsync(AttendanceStatus status)
    {
        if (_practice is null || !_isAttendanceEditable)
            return;

        try
        {
            await AttendanceService.SetStatusAsync(_practice.Id, Profile.MemberId, Profile.Name, Profile.Part, status);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"更新に失敗しました。({ex.Message})";
        }
    }

    private async Task EditRecordingAsync(SongParticipation song)
    {
        if (Profile.Role != Role.Admin || _practice is null)
            return;

        var input = await JS.InvokeAsync<string?>("prompt",
            $"{song.Title} の録音リンク\nOneDriveの共有リンクを入力してください。空欄で保存するとリンクを削除します。",
            song.RecordingUrl ?? "");

        if (input is null)
            return;

        var trimmed = input.Trim();
        if (trimmed.Length > 0 && !Uri.TryCreate(trimmed, UriKind.Absolute, out _))
        {
            _errorMessage = "リンクの形式が正しくありません。";
            return;
        }

        try
        {
            await PracticeService.SetPieceRecordingUrlAsync(_practice.Id, song.PieceId, trimmed.Length > 0 ? trimmed : null);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"録音リンクの保存に失敗しました。({ex.Message})";
        }
    }

    private async Task ToggleRecordingFeaturedAsync(SongParticipation song)
    {
        if (Profile.Role != Role.Admin || _practice is null || !song.HasRecordingUrl)
            return;

        try
        {
            await PracticeService.SetPieceRecordingFeaturedAsync(_practice.Id, song.PieceId, !song.IsFeatured);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"更新に失敗しました。({ex.Message})";
        }
    }

    private void OpenScheduleEditPanel()
    {
        if (_practice is null)
            return;

        _editStartTime = PracticeScheduleValidator.ParseTimeOrNull(_practice.StartTime);
        _editEndTime = PracticeScheduleValidator.ParseTimeOrNull(_practice.EndTime);
        _editTimelineItems = _practice.TimelineItems
            .OrderBy(i => i.StartTime)
            .Select(i => new TimelineItemInput
            {
                StartTime = PracticeScheduleValidator.ParseTimeOrNull(i.StartTime),
                EndTime = PracticeScheduleValidator.ParseTimeOrNull(i.EndTime),
                Content = i.Content
            })
            .ToList();
        _isScheduleEditPanelVisible = true;
    }

    private void CloseScheduleEditPanel() => _isScheduleEditPanelVisible = false;

    private void AddEditTimelineItem() => _editTimelineItems.Add(new TimelineItemInput());

    private void RemoveEditTimelineItem(TimelineItemInput item) => _editTimelineItems.Remove(item);

    private async Task SaveScheduleAsync()
    {
        if (Profile.Role != Role.Admin || _practice is null)
            return;

        _errorMessage = null;

        if (!PracticeScheduleValidator.TryValidateTimeRange(_editStartTime, _editEndTime, out var rangeError))
        {
            _errorMessage = rangeError;
            return;
        }

        var timelineItems = new List<PracticeTimelineItem>();
        foreach (var item in _editTimelineItems)
        {
            if (!PracticeScheduleValidator.TryValidateTimelineItem(item, out var itemError))
            {
                _errorMessage = itemError;
                return;
            }
            timelineItems.Add(new PracticeTimelineItem { StartTime = item.StartTime!.Value.ToString("HH:mm"), EndTime = item.EndTime!.Value.ToString("HH:mm"), Content = item.Content.Trim() });
        }

        try
        {
            var startTime = _editStartTime?.ToString("HH:mm") ?? string.Empty;
            var endTime = _editEndTime?.ToString("HH:mm") ?? string.Empty;
            await PracticeService.UpdateScheduleAsync(_practice.Id, startTime, endTime, timelineItems);
            _isScheduleEditPanelVisible = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"タイムスケジュールの保存に失敗しました。({ex.Message})";
        }
    }

    private void OpenPiecesEditPanel()
    {
        if (_practice is null)
            return;

        var selectedPieceIds = _practice.Pieces.Select(p => p.PieceId).ToHashSet();
        _editPieceInputs = _pieces
            .Select(p => new PieceSelectionInput { PieceId = p.Id, Title = p.Title, IsSelected = selectedPieceIds.Contains(p.Id) })
            .ToList();
        _isPiecesEditPanelVisible = true;
    }

    private void ClosePiecesEditPanel() => _isPiecesEditPanelVisible = false;

    private async Task SavePiecesAsync()
    {
        if (Profile.Role != Role.Admin || _practice is null)
            return;

        _errorMessage = null;

        var updatedPieces = PracticePieceMerger.MergeSelectedPieces(_practice.Pieces, _editPieceInputs);

        try
        {
            await PracticeService.UpdatePiecesAsync(_practice.Id, updatedPieces);
            _isPiecesEditPanelVisible = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"演奏予定曲の保存に失敗しました。({ex.Message})";
        }
    }

    private async Task DeletePracticeAsync()
    {
        if (Profile.Role != Role.Admin || _practice is null)
            return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", "この練習予定を削除します。よろしいですか？");
        if (!confirmed)
            return;

        try
        {
            await PracticeService.DeleteAsync(_practice.Id);
            Nav.NavigateTo("schedule");
        }
        catch (Exception ex)
        {
            _errorMessage = $"削除に失敗しました。({ex.Message})";
        }
    }

    private async Task ToggleKeyPickedUpAsync()
    {
        if (Profile.Role != Role.Admin || _practice is null)
            return;

        try
        {
            await PracticeService.SetKeyPickedUpAsync(_practice.Id, !_practice.KeyPickedUp, Profile.Name);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"更新に失敗しました。({ex.Message})";
        }
    }
}
