@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject LocalProfileStore Profile
@inject AppUpdateWatcher UpdateWatcher
@implements IDisposable

<div class="app-shell">
    @if (UpdateWatcher.IsUpdateAvailable)
    {
        <div class="update-banner">
            <span>新しいバージョンがあります。</span>
            <button class="iyk-btn-text-primary" @onclick="Reload">今すぐ更新</button>
        </div>
    }

    @if (_showNav)
    {
        <HamburgerMenu />
    }

    <main class="app-main @(_showNav ? "app-main-with-menu" : "")">
        @Body
    </main>
</div>

@code {
    private bool _showNav;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UpdateWatcher.UpdateAvailable += OnUpdateAvailable;
        CheckRegistration();
        _ = UpdateWatcher.CaptureCurrentVersionAsync();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        CheckRegistration();
        _ = UpdateWatcher.CheckForUpdateAsync();
    }

    private void OnUpdateAvailable() => InvokeAsync(StateHasChanged);

    private void Reload() => Nav.NavigateTo(Nav.Uri, forceLoad: true);

    private void CheckRegistration()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).ToLowerInvariant();
        var isAuthPage = path.StartsWith("onboarding", StringComparison.Ordinal) || path.StartsWith("login", StringComparison.Ordinal);

        if (!Profile.IsRegistered && !isAuthPage)
        {
            Nav.NavigateTo("onboarding");
            _showNav = false;
        }
        else
        {
            _showNav = !isAuthPage;
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        UpdateWatcher.UpdateAvailable -= OnUpdateAvailable;
    }
}
