@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject LocalProfileStore Profile
@implements IDisposable

<div class="app-shell">
    @if (_showNav)
    {
        <HamburgerMenu />
    }

    <main class="app-main @(_showNav ? "app-main-with-menu" : "")">
        @Body
    </main>
</div>

@code {
    private bool _showNav;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        CheckRegistration();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => CheckRegistration();

    private void CheckRegistration()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).ToLowerInvariant();
        var isAuthPage = path.StartsWith("onboarding", StringComparison.Ordinal) || path.StartsWith("login", StringComparison.Ordinal);

        if (!Profile.IsRegistered && !isAuthPage)
        {
            Nav.NavigateTo("onboarding");
            _showNav = false;
        }
        else
        {
            _showNav = !isAuthPage;
        }

        StateHasChanged();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
