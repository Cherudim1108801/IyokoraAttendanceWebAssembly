{
  "hosting": {
    "public": "IyokoraAttendanceWebAssembly/bin/Release/net10.0/publish/wwwroot",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/*.br",
      "**/*.gz"
    ],
    "headers": [
      {
        "source": "**/*.dll",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          }
        ]
      },
      {
        "source": "_framework/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
